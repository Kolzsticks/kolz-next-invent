// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())  // Auto-incrementing unique identifier
  name     String @db.VarChar(255)              // Full name
  username String @unique           // Username
  role     String @db.VarChar(100)              // Role (e.g., admin, user, etc.)
  password String @db.VarChar(255)              // Password (hashed or plain text)
  image    String? @db.VarChar(255)             // Optional image URL
}

model Product {
  id          Int      @id @default(autoincrement()) 
  name        String   @db.VarChar(255)          
  category    String   @db.VarChar(100)
  subcategory String?  @db.VarChar(100)            
  price       Decimal
  venue       String?  @db.VarChar(255)
  quantity    Int     @default(0)    
  image_url  String?  @db.VarChar(255)
  date        DateTime @default(now()) 
  Sale       Sales[]       
}


model Category {
  id          Int      @id @default(autoincrement()) 
  name        String   @db.VarChar(255)          
  date        DateTime @default(now()) 
  Subcategory Subcategory[]             
}

model Subcategory {
  id          Int      @id @default(autoincrement()) 
  name        String   @db.VarChar(255)          
  category    Category @relation(fields: [category_id], references: [id])
  category_id Int
  date        DateTime @default(now())              
}

model Sales {
  id          Int      @id @default(autoincrement()) 
  product     Product  @relation(fields: [product_id], references: [id])
  product_id  Int
  price       Decimal
  quantity    Int
  date        DateTime @default(now()) 
}
